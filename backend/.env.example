# Server-side Gemini API key (NEVER expose to or accept from frontend)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Firebase Admin SDK configuration
FIREBASE_PROJECT_ID=storied-backbone-85gvv
# Provide either a path to service account JSON OR inline JSON string in production
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_CREDENTIALS_JSON=

# CORS & Security
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=production
# Keep false in production; only set true for local automated testing without Firebase tokens
ALLOW_DEMO_BYPASS=false

# Resilience, Rate Limits & Timeouts
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
GEMINI_TIMEOUT_SECONDS=15.0
GEMINI_MAX_RETRIES=2
